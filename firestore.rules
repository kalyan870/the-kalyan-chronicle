rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidReaderProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'createdAt'])
        && isValidId(data.userId)
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidReaderSession(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.status is string
        && data.status in ['active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReaderMemory(data, userId, sessionId) {
      return data.keys().hasAll(['ownerId', 'sessionId', 'role', 'content', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'sessionId', 'role', 'content', 'citations', 'createdAt'])
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && isValidId(data.sessionId)
        && data.sessionId == sessionId
        && data.role is string
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 4000
        && (!('citations' in data) || (
          data.citations is list
          && data.citations.size() <= 6
          && (data.citations.size() == 0 || (data.citations[0] is string && data.citations[0].size() <= 160))
        ))
        && data.createdAt is timestamp;
    }

    match /readers/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidReaderProfile(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidReaderProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /sessions/{sessionId} {
        allow get: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidReaderSession(incoming(), userId)
          && incoming().status == 'active'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/readers/$(userId));
        allow update: if isValidId(userId)
          && isValidId(sessionId)
          && isOwner(userId)
          && isValidReaderSession(incoming(), userId)
          && existing().status != 'archived'
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt'])) ||
            (incoming().status == 'archived' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(sessionId) && isOwner(userId);

        match /memories/{memoryId} {
          allow get: if isValidId(userId)
            && isValidId(sessionId)
            && isValidId(memoryId)
            && isOwner(userId)
            && existing().ownerId == request.auth.uid
            && get(/databases/$(database)/documents/readers/$(userId)/sessions/$(sessionId)).data.ownerId == request.auth.uid;
          allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId)
            && isValidId(sessionId)
            && isValidId(memoryId)
            && isOwner(userId)
            && isValidReaderMemory(incoming(), userId, sessionId)
            && incoming().createdAt == request.time
            && get(/databases/$(database)/documents/readers/$(userId)/sessions/$(sessionId)).data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/readers/$(userId)/sessions/$(sessionId)).data.status == 'active';
          allow update: if false;
          allow delete: if isValidId(userId)
            && isValidId(sessionId)
            && isValidId(memoryId)
            && isOwner(userId)
            && existing().ownerId == request.auth.uid;
        }
      }
    }
  }
}
