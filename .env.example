# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Clerk Authentication (https://clerk.com)
# Publishable key is public for Vite; secret key must remain server-side only.
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Neon PostgreSQL (https://neon.tech)
# Server-only connection string — NEVER expose in browser/VITE_ env vars.
DATABASE_URL=""

# Cloudflare R2 Object Storage & Presigned Media Uploads (S3-compatible)
# Bucket-scoped read/write credentials kept strictly on the server.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kalyan-chronicle-editions"

# Resend Email Delivery (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="The Kalyan Chronicle <onboarding@resend.dev>"
RESEND_AUDIENCE_ID=""
UNSUBSCRIBE_SECRET=""

# Automation & Scheduled Cron Pipeline (Vercel Cron / GitHub Actions / Cloudflare Triggers)
# Server-only secret token used to authorize unattended /api/cron/daily-edition runs.
CRON_SECRET=""
CRON_DIGEST_RECIPIENT="saragadamkalyan068@gmail.com"

# Firebase Auth Server Verification
FIREBASE_PROJECT_ID=""
FIREBASE_AUTH_REQUIRED="false"

# Cloudflare Pages / Zero Trust Access Verification (Backend-only)
CLOUDFLARE_ACCESS_TEAM_DOMAIN=""
CLOUDFLARE_ACCESS_AUD=""
CLOUDFLARE_ACCESS_SERVICE_TOKEN_ID=""
CLOUDFLARE_ACCESS_SERVICE_TOKEN_SECRET=""
CLOUDFLARE_ENFORCE_ALL_BACKEND_API="false"

